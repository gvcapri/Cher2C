# ===========================================
# Cher2C - Environment Variables (example)
# Copie para .env e preencha os valores
# ===========================================

# Backend
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://cher2c:cher2c_dev_password@localhost:5432/cher2c

# Auth JWT (mínimo 32 chars em produção)
JWT_SECRET=dev_jwt_secret_cher2c_must_be_32_chars_min

# LiveKit (SFU self-hosted)
# API key/secret devem ser os mesmos do livekit.yaml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_cher2c_secret_key_123456

# Redis (opcional - single-node não precisa)
REDIS_URL=redis://localhost:6379

# CORS (origem do cliente Electron/Vite)
CORS_ORIGIN=http://localhost:5173
